# Development only. Production validation rejects these values and local backends.
FDE_ENVIRONMENT=development
FDE_DATABASE_URL=sqlite:///.data/fde.db
FDE_PUBLIC_URL=http://127.0.0.1:8800
FDE_PATTERN_URL=http://127.0.0.1:8801
FDE_ROUTER_URL=http://127.0.0.1:8802
FDE_ROUTER_TOKEN=development-router-token
FDE_SESSION_SECRET=development-only-change-session-secret
FDE_SERVICE_SECRET=development-only-change-service-secret
FDE_OBJECT_BACKEND=local
FDE_OBJECT_ROOT=.data/objects
FDE_EMBEDDING_BACKEND=development
FDE_EMBEDDING_MODEL=multilingual-e5-small
FDE_VIRUS_BACKEND=development
FDE_ALLOW_REGISTRATION=true
FDE_CREDENTIAL_ENCRYPTION_KEY=

# Personal provider generation timeout (seconds), separate from Router control requests.
FDE_PROVIDER_TIMEOUT=180
FDE_PROVIDER_MAX_OUTPUT_TOKENS=16384
