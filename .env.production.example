FDE_ENVIRONMENT=production
FDE_DATABASE_URL=postgresql+psycopg://fde_app:REPLACE_FROM_SECRET_MANAGER@postgres:5432/fde
FDE_MIGRATION_DATABASE_URL=postgresql+psycopg://fde_migrator:REPLACE_FROM_SECRET_MANAGER@postgres:5432/fde
FDE_PUBLIC_URL=https://fde.example.com
FDE_PATTERN_URL=http://pattern:8801
FDE_ROUTER_URL=https://sudorouter.internal.example.com
FDE_ROUTER_TOKEN=REPLACE_FROM_SECRET_MANAGER
FDE_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
FDE_SERVICE_SECRET=REPLACE_WITH_ANOTHER_INDEPENDENT_SECRET
FDE_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
FDE_OBJECT_BACKEND=s3
FDE_S3_ENDPOINT=https://objects.internal.example.com
FDE_S3_BUCKET=fde-private
FDE_S3_REGION=us-east-1
# Prefer workload identity; otherwise inject scoped AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
FDE_EMBEDDING_BACKEND=internal
FDE_EMBEDDING_URL=http://embedding:80
FDE_EMBEDDING_MODEL=intfloat/multilingual-e5-small@PINNED_REVISION
FDE_VIRUS_BACKEND=clamav
FDE_CLAMAV_HOST=clamav
FDE_SMTP_HOST=smtp.internal.example.com
FDE_SMTP_PORT=587
FDE_SMTP_FROM=FDE <noreply@example.com>
FDE_SMTP_STARTTLS=true
FDE_ALLOW_REGISTRATION=false
FDE_PLATFORM_ADMIN_EMAILS=["admin@sudoprivacy.com"]
FDE_TRUST_PROXY=true
# Set to the actual reverse-proxy source addresses/network, never a public client range.
FDE_FORWARDED_ALLOW_IPS=127.0.0.1

# Personal provider generation timeout (seconds), separate from Router control requests.
FDE_PROVIDER_TIMEOUT=180
FDE_PROVIDER_MAX_OUTPUT_TOKENS=16384
